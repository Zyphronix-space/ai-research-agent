GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Sign-In (optional — email/password auth works without it; this only
# enables the Google button and the ability to sign in that way). Create an
# OAuth 2.0 Client ID at console.cloud.google.com/apis/credentials —
# Application type "Web application" — and add both your frontend dev/prod
# origins under "Authorized JavaScript origins" (no path, no trailing slash).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Resend (required for "forgot password" to actually send an email — every
# other feature, including email/password signup and login, works without
# it). Get a free API key at resend.com. Until this is set, /auth/forgot-
# password returns a clear 500 instead of silently pretending to send.
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=ResearchOS <onboarding@resend.dev>
