GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Sign-In (optional — /chat works without it; only the sign-in
# button and server-persisted history need it). Create an OAuth 2.0 Client
# ID at console.cloud.google.com/apis/credentials — Application type "Web
# application" — and add both your frontend dev/prod origins under
# "Authorized JavaScript origins" (no path, no trailing slash).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
